{
  "name": "equidna/domain-token-auth",
  "description": "Secure domain-based token authentication package for Laravel",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "symfony/http-foundation": "^7.2|^8.0"
  },
  "suggest": {
    "equidna/bee-hive": "Required for multi-tenant context propagation after token authentication (^1.0)"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5.3|^12.0.1|^13.0.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Equidna\\DomainTokenAuth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Equidna\\DomainTokenAuth\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Equidna\\DomainTokenAuth\\Providers\\DomainTokenAuthServiceProvider"
      ],
      "aliases": {
        "DomainToken": "Equidna\\DomainTokenAuth\\Facades\\DomainToken"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
